# ============================================================
# ShieldVault Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# Sepolia RPC (get one free from Alchemy or Infura)
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY

# Deployer private key (no 0x prefix)
PRIVATE_KEY=your_private_key_here

# Etherscan API key (for contract verification)
ETHERSCAN_API_KEY=your_etherscan_api_key

# ============================================================
# Zama Registry Address
# Get the Sepolia address from:
# https://docs.zama.org/protocol/protocol-apps/addresses.md
# Mainnet: 0xeb5015fF021DB115aCe010f23F55C2591059bBA0
# ============================================================
REGISTRY_ADDRESS_SEPOLIA=FILL_ME_IN_FROM_DOCS

# Vault admin (optional — defaults to deployer)
# In production, set this to your DAO multisig address
VAULT_ADMIN_ADDRESS=

# ============================================================
# Zama FHEVM Sepolia Addresses (pre-filled from docs)
# ============================================================
FHEVM_EXECUTOR_CONTRACT=0x92C920834Ec8941d2C77D188936E1f7A6f49c127
ACL_CONTRACT=0xf0Ffdc93b7E186bC2f8CB3dAA75D86d1930A433D
KMS_VERIFIER_CONTRACT=0xbE0E383937d564D7FF0BC3b46c51f0bF8d5C311A
INPUT_VERIFIER_CONTRACT=0xBBC1fFCdc7C316aAAd72E807D9b0272BE8F84DA0
RELAYER_URL=https://relayer.testnet.zama.org
