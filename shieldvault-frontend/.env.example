# ── ShieldVault Frontend Env ─────────────────────────────────────────────────
# Copy to .env and fill in your values

# Deployed addresses (copy from the contract deploy output)
VITE_FACTORY_ADDRESS=0x6AF19cF8dCb588DCc239726e87881B8AfbF0F1b2
VITE_VAULT_ADDRESS=0x430d43d293de91a008Cc48dB6116b5CAca687077
VITE_REGISTRY_ADDRESS=0x2f0750Bbb0A246059d80e94c454586a7F27a128e

# Sepolia RPC (same key you used for contracts)
VITE_SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# Zama relayer
VITE_RELAYER_URL=https://relayer.testnet.zama.org

# WalletConnect project ID (optional — get one free at cloud.walletconnect.com)
VITE_WALLETCONNECT_PROJECT_ID=
